#!/bin/bash
# Copy the active Omarchy theme colors into the extension so the new tab can follow them.
# Run by the Omarchy theme-set hook; safe to run by hand.
set -euo pipefail

theme_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
colors="$theme_dir/colors.toml"
name_file="$(dirname "$theme_dir")/theme.name"
out="$(cd "$(dirname "$0")/.." && pwd)/src/omarchy-theme.json"

[[ -f $colors ]] || { echo "no Omarchy theme colors at $colors" >&2; exit 1; }

get() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(.*\)\".*/\1/p" "$colors" | head -1; }

name="$(cat "$name_file" 2>/dev/null || echo omarchy)"
tmp="$(mktemp "$out.XXXXXX")"
cat >"$tmp" <<JSON
{
  "name": "$name",
  "mode": "$(get mode)",
  "bg": "$(get background)",
  "surface": "$(get lighter_background)",
  "line": "$(get selection)",
  "fg": "$(get foreground)",
  "bright": "$(get bright_foreground)",
  "muted": "$(get muted)",
  "accent": "$(get accent)",
  "red": "$(get red)",
  "yellow": "$(get yellow)",
  "green": "$(get green)",
  "cyan": "$(get cyan)",
  "magenta": "$(get magenta)"
}
JSON
chmod 644 "$tmp"
mv "$tmp" "$out"
