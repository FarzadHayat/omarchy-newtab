#!/bin/bash
# Copy the active Omarchy theme colors and wallpaper into the extension so the new tab
# can follow them.
# Run by the Omarchy theme-set hook and the wallpaper watcher; safe to run by hand.
set -euo pipefail

# Omarchy always keeps its state here, whatever XDG_STATE_HOME says.
current="$HOME/.local/state/omarchy/current"
colors="$current/theme/colors.toml"
background="$current/background"
src="$(cd "$(dirname "$0")/.." && pwd)/src"
out="$src/omarchy-theme.json"

[[ -f $colors ]] || { echo "no Omarchy theme colors at $colors" >&2; exit 1; }

# The theme hook and the wallpaper watcher both fire on a theme switch; run one at a time.
exec 9>"$src/.sync.lock"
flock 9

tmp=""
trap 'rm -f "$tmp" "$src/omarchy-wallpaper.jpg.tmp"' EXIT

# First quoted value for a key; accepts "double" or 'single' quotes.
get() { sed -n "s/^$1[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" "$colors" | head -1; }

# Escape a value for a JSON string.
json() { printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

name="$(cat "$current/theme.name" 2>/dev/null || echo omarchy)"

# ---------- look: the desktop's shape and glass, not just its colors ----------

shell_toml="$current/theme/shell.toml"

# Value of a key inside one [section] of shell.toml, without quotes or trailing comment.
shell_get() {
  [[ -f $shell_toml ]] || return 0
  awk -v s="[$1]" -v k="$2" '
    /^[[:space:]]*\[/ { in_s = ($1 == s); next }
    in_s && $1 == k {
      sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+#.*/, ""); gsub(/["\047]/, "")
      print; exit
    }' "$shell_toml"
}

# Live Hyprland value, so user overrides count too. Empty when Hyprland can't be asked.
hypr() {
  command -v hyprctl >/dev/null && command -v jq >/dev/null || return 0
  timeout 2 hyprctl -j getoption "$1" 2>/dev/null |
    jq -r '[.int, .float, .bool, .gradient, .custom] | map(select(. != null) | tostring) | .[0] // empty' 2>/dev/null || true
}

# The previous sync's value, for when Hyprland isn't reachable (say, from the wallpaper
# watcher before a session is up), so the page keeps its shape instead of going square.
prev() { command -v jq >/dev/null && jq -c ".look.$1 // empty" "$out" 2>/dev/null || true; }

# Hyprland gradients come as "AARRGGBB AARRGGBB 45deg"; give CSS-ordered hex colors.
grad_colors() {
  local t list=""
  for t in $1; do [[ $t =~ ^[0-9a-fA-F]{8}$ ]] && list+="${list:+, }\"#${t:2}${t:0:2}\""; done
  [[ -z $list ]] || printf '[%s]' "$list"
}
grad_angle() {
  local t
  for t in $1; do if [[ $t =~ ^([0-9]+)deg$ ]]; then echo "${BASH_REMATCH[1]}"; return; fi; done
}

# A number matching the pattern, else the fallback.
num() { [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] && echo "$1" || echo "$2"; }

active_border="$(hypr general:col.active_border)"
inactive_border="$(hypr general:col.inactive_border)"
radius="$(num "$(hypr decoration:rounding)" "$(num "$(prev radius)" 0)")"
corner_power="$(num "$(hypr decoration:rounding_power)" "$(num "$(prev cornerPower)" 2)")"
border="$(num "$(hypr general:border_size)" "$(num "$(prev border)" 2)")"
blur="$(hypr decoration:blur:enabled)"; [[ $blur == true || $blur == false ]] || blur="$(prev blur)"
shadow="$(hypr decoration:shadow:enabled)"; [[ $shadow == true || $shadow == false ]] || shadow="$(prev shadow)"
rim="$(grad_colors "$active_border")"; rim="${rim:-$(prev rim)}"
rim_idle="$(grad_colors "$inactive_border")"; rim_idle="${rim_idle:-$(prev rimIdle)}"
rim_angle="$(num "$(grad_angle "$active_border")" "$(num "$(prev rimAngle)" 0)")"
bar_style="$(shell_get bar style)"; [[ $bar_style =~ ^[a-z-]{1,20}$ ]] || bar_style=""

# Shrink the wallpaper so new tabs stay fast; the version busts the browser cache.
# A wallpaper that can't be converted keeps the previous one instead of stopping the color sync.
wallpaper=""
if [[ -f $background ]]; then
  source_path="$(readlink -f "$background")"
  version="$(stat -c %Y "$source_path")-$(printf '%s' "$source_path" | cksum | cut -d' ' -f1)"
  if [[ "$(cat "$src/.omarchy-wallpaper.version" 2>/dev/null)" != "$version" ]]; then
    converted=false
    if command -v magick >/dev/null; then
      # [0] takes the first frame, so animated wallpapers still give one image.
      magick "${source_path}[0]" -resize '2560x1600>' -quality 82 "jpg:$src/omarchy-wallpaper.jpg.tmp" && converted=true
    else
      cp "$source_path" "$src/omarchy-wallpaper.jpg.tmp" && converted=true
    fi
    if $converted; then
      mv "$src/omarchy-wallpaper.jpg.tmp" "$src/omarchy-wallpaper.jpg"
      echo "$version" >"$src/.omarchy-wallpaper.version"
    else
      echo "couldn't convert wallpaper $source_path; keeping the previous one" >&2
    fi
  fi
  if [[ -f $src/omarchy-wallpaper.jpg ]]; then
    wallpaper="omarchy-wallpaper.jpg?v=$(cat "$src/.omarchy-wallpaper.version" 2>/dev/null || echo 0)"
  fi
fi

tmp="$(mktemp "$out.XXXXXX")"
cat >"$tmp" <<JSON
{
  "name": "$(json "$name")",
  "wallpaper": "$(json "$wallpaper")",
  "mode": "$(json "$(get mode)")",
  "bg": "$(json "$(get background)")",
  "surface": "$(json "$(get lighter_background)")",
  "line": "$(json "$(get selection)")",
  "fg": "$(json "$(get foreground)")",
  "bright": "$(json "$(get bright_foreground)")",
  "muted": "$(json "$(get muted)")",
  "accent": "$(json "$(get accent)")",
  "red": "$(json "$(get red)")",
  "yellow": "$(json "$(get yellow)")",
  "green": "$(json "$(get green)")",
  "cyan": "$(json "$(get cyan)")",
  "magenta": "$(json "$(get magenta)")",
  "look": {
    "radius": $radius,
    "cornerPower": $corner_power,
    "border": $border,
    "blur": ${blur:-false},
    "shadow": ${shadow:-false},
    "rim": ${rim:-[]},
    "rimIdle": ${rim_idle:-[]},
    "rimAngle": $rim_angle,
    "glass": $(num "$(shell_get menu background-alpha)" 1),
    "scrim": $(num "$(shell_get menu scrim-alpha)" 0.5),
    "bar": $(num "$(shell_get bar background-alpha)" 1),
    "barStyle": "$bar_style"
  }
}
JSON
chmod 644 "$tmp"
mv "$tmp" "$out"
tmp=""
